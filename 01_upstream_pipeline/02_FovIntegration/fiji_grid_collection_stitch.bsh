import ij.IJ;
import ij.ImagePlus;
import ij.WindowManager;
import java.io.File;
import loci.plugins.LociExporter;
import loci.plugins.out.Exporter;

String requireEnvironment(String name) {
    String value = System.getenv(name);
    if (value == null || value.isEmpty()) {
        throw new RuntimeException("Environment variable '" + name + "' is not set.");
    }
    if (value.indexOf(';') >= 0) {
        throw new RuntimeException("Environment variable '" + name + "' must not contain ';'.");
    }
    return value;
}

String pair(String key, String value) {
    return key + "=" + value;
}

print("==============================================================");
print("Starting fiji_grid_collection_stitch.bsh...");

String INPUT_DIR = requireEnvironment("INPUT_DIR");
String OUTPUT_NAME = requireEnvironment("OUTPUT_NAME");
String STITCH_PATTERN = requireEnvironment("STITCH_PATTERN");
String OUTPUT_DIRECTORY = requireEnvironment("OUTPUT_DIRECTORY");
String SAVE_FORMAT = requireEnvironment("SAVE_FORMAT");
String SCRIPT_DIR = requireEnvironment("SCRIPT_DIR");

String args = pair("input_dir", INPUT_DIR) + ";" +
    pair("output_name", OUTPUT_NAME) + ";" +
    pair("stitch_pattern", STITCH_PATTERN) + ";" +
    pair("output_directory", OUTPUT_DIRECTORY) + ";" +
    pair("save_format", SAVE_FORMAT);

if (STITCH_PATTERN.equals("Snake_row_Right_down")) {
    args = args + ";" + pair("grid_x", requireEnvironment("GRID_X")) + ";" +
        pair("grid_y", requireEnvironment("GRID_Y")) + ";" +
        pair("first_index", requireEnvironment("FIRST_INDEX")) + ";" +
        pair("output_textfile_name", requireEnvironment("OUTPUT_TEXTFILE_NAME")) + ";" +
        pair("regression_threshold", requireEnvironment("REGRESSION_THRESHOLD")) + ";" +
        pair("max_avg_displacement_threshold", requireEnvironment("MAX_AVG_DISPLACEMENT_THRESHOLD")) + ";" +
        pair("absolute_displacement_threshold", requireEnvironment("ABSOLUTE_DISPLACEMENT_THRESHOLD")) + ";" +
        pair("fusion_method", requireEnvironment("FUSION_METHOD")) + ";" +
        pair("compute_overlap", requireEnvironment("COMPUTE_OVERLAP")) + ";" +
        pair("subpixel_accuracy", requireEnvironment("SUBPIXEL_ACCURACY")) + ";" +
        pair("computation_parameters", requireEnvironment("COMPUTATION_PARAMETERS")) + ";" +
        pair("image_output", requireEnvironment("IMAGE_OUTPUT"));
} else if (STITCH_PATTERN.equals("Positions_from_file")) {
    args = args + ";" + pair("layout_file", requireEnvironment("LAYOUT_FILE")) + ";" +
        pair("regression_threshold", requireEnvironment("REGRESSION_THRESHOLD")) + ";" +
        pair("max_avg_displacement_threshold", requireEnvironment("MAX_AVG_DISPLACEMENT_THRESHOLD")) + ";" +
        pair("absolute_displacement_threshold", requireEnvironment("ABSOLUTE_DISPLACEMENT_THRESHOLD")) + ";" +
        pair("fusion_method", requireEnvironment("FUSION_METHOD")) + ";" +
        pair("compute_overlap", requireEnvironment("COMPUTE_OVERLAP")) + ";" +
        pair("subpixel_accuracy", requireEnvironment("SUBPIXEL_ACCURACY")) + ";" +
        pair("computation_parameters", requireEnvironment("COMPUTATION_PARAMETERS")) + ";" +
        pair("image_output", requireEnvironment("IMAGE_OUTPUT"));
} else if (STITCH_PATTERN.equals("Positions_from_file_mosaic")) {
    args = args + ";" + pair("layout_file", requireEnvironment("LAYOUT_FILE")) + ";" +
        pair("fusion_method", requireEnvironment("FUSION_METHOD")) + ";" +
        pair("subpixel_accuracy", requireEnvironment("SUBPIXEL_ACCURACY")) + ";" +
        pair("image_output", requireEnvironment("IMAGE_OUTPUT"));
} else if (
    STITCH_PATTERN.equals("Positions_from_file_p1") ||
    STITCH_PATTERN.equals("Positions_from_file_p2") ||
    STITCH_PATTERN.equals("Positions_from_file_downsampled")
) {
    // These legacy macro branches define their Fiji parameters internally.
} else {
    throw new RuntimeException("Unknown STITCH_PATTERN: " + STITCH_PATTERN);
}

mpicbg.stitching.GlobalOptimization.ignoreZ = true;
print("Set mpicbg.stitching.GlobalOptimization.ignoreZ = true");
print("Arguments: " + args);

String macroPath = SCRIPT_DIR + "/fiji_grid_collection_stitch.ijm";
File macroFile = new File(macroPath);
if (!macroFile.exists()) {
    throw new RuntimeException("Macro file not found: " + macroPath);
}

print("Running macro script: " + macroPath);
IJ.runMacroFile(macroPath, args);
print("Finished running macro script.");

if (SAVE_FORMAT.equals("ome_tiff") || SAVE_FORMAT.equals("ome_bigtiff")) {
    ImagePlus projection = WindowManager.getCurrentImage();
    if (projection == null) {
        throw new RuntimeException("No current 2D projection is available for OME export.");
    }

    String extension = SAVE_FORMAT.equals("ome_tiff") ? ".ome.tif" : ".ome.btf";
    String outputPath = OUTPUT_DIRECTORY + "/" + OUTPUT_NAME + "_2d_Fiji" + extension;
    LociExporter plugin = new LociExporter();
    plugin.arg = "outfile=[" + outputPath + "] windowless=true compression=Uncompressed saveRoi=false";
    Exporter exporter = new Exporter(plugin, projection);
    exporter.run();

    File outputFile = new File(outputPath);
    if (!outputFile.isFile() || outputFile.length() == 0) {
        throw new RuntimeException("Bio-Formats export failed: " + outputPath);
    }
    print("Saved 2D OME projection: " + outputPath);
}

while (WindowManager.getImageCount() > 0) {
    ImagePlus openImage = WindowManager.getCurrentImage();
    if (openImage == null) break;
    openImage.changes = false;
    openImage.close();
}
